# Dependencies and tool caches
node_modules
.npm-cache
__pycache__

# Build output: dist/ (npm run build), standalone sites (npm run standalone),
# and the release zips the standalone workflow makes
dist
standalone
release

# Local environment and secrets (.env.example is committed)
.env

# Real catalog and thumbnails, for local development only. The directories
# are ignored whole; their .gitkeep placeholders stay tracked, so a fresh
# clone has the directories. The container mounts its own copies instead
# (docker-compose.yml).
public/assets/api/*
!public/assets/api/.gitkeep
public/assets/thumbnails/*
!public/assets/thumbnails/.gitkeep

# The old single-file catalog and the Games.txt/Videos.txt that
# migrate_catalog.py makes from it: the maintainer's own data.
migration

# Editor, OS and tool files
.idea
.DS_Store
.claude
.mcp.json
