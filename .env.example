# Copy this to .env next to the compose files and fill it in. Commented-out
# settings show their defaults. The domains below are the defaults.

# ---------- Required ----------

# The hostname Traefik routes to this site. Defaults to playshelf.kostelidis.dev.
DOMAIN=playshelf.kostelidis.dev

# The hostname for the catalog editor, which needs a host of its own: an app
# installed from DOMAIN covers /studio/, so the editor couldn't be installed
# beside it. DNS, and the certificate, must cover this name too. Defaults to
# playshelf-studio.kostelidis.dev.
EDITOR_DOMAIN=playshelf-studio.kostelidis.dev

# The site's address, its root. Search engines and link previews use it for
# the canonical link and the preview image. Defaults to https://DOMAIN. Read
# when the container starts.
SITE_URL=https://playshelf.kostelidis.dev

# The basic-auth users, in htpasswd format, with every "$" written as "$$".
# The catalog editor always asks for them, and so does the site when
# docker-compose.basic-auth.yml is used. Compose won't start without this
# line. To make one:
#   htpasswd -nbB user 'password' | sed -e 's/\$/\$\$/g'
PLAYSHELF_AUTH=user:$$2y$$05$$replace-with-a-real-bcrypt-hash

# Where the catalog (Games.txt and Videos.txt) lives; the container mounts it read-only.
# It can be a bind mount, an NFS export or a CIFS/SMB share: set TYPE,
# OPTIONS and DEVICE as in one of the examples below. The container runs as
# uid/gid 82, which must be able to read it.
#
#   Bind (a directory on this host; it must exist):
#     TYPE=none   OPTIONS=bind
#     DEVICE=/srv/playshelf/data
#
#   NFS (the host needs nfs-common / nfs-utils):
#     TYPE=nfs    OPTIONS=addr=192.168.1.10,nfsvers=4,ro
#     DEVICE=:/export/playshelf/data          (the export must let uid 82 read)
#
#   CIFS/SMB (the host needs cifs-utils; addr must be an IP address, and the
#   password can't contain commas):
#     TYPE=cifs   OPTIONS=addr=192.168.1.10,username=playshelf,password=secret,vers=3.0,uid=82,gid=82,file_mode=0644,dir_mode=0755,ro
#     DEVICE=//192.168.1.10/playshelf/data
#
# Docker keeps a volume's settings from when it was created. After changing
# these, run `docker compose down` and `docker volume rm <INSTANCE_NAME>-data`
# before `docker compose up -d`.
PLAYSHELF_DATA_VOLUME_TYPE=none
PLAYSHELF_DATA_VOLUME_OPTIONS=bind
PLAYSHELF_DATA_VOLUME_DEVICE=/srv/playshelf/data

# The thumbnails and covers (assets/thumbnails): a volume of its own, set the
# same way as the catalog's above, and read-only in the container. It can be
# a different kind of share from the catalog's. The container must be able to
# read it, and after changing it the volume is recreated as for the catalog's
# (`docker volume rm <INSTANCE_NAME>-thumbnails`).
#   Bind:  TYPE=none  OPTIONS=bind  DEVICE=/srv/playshelf/thumbnails
#   NFS:   TYPE=nfs   OPTIONS=addr=192.168.1.10,nfsvers=4,ro  DEVICE=:/export/playshelf/thumbnails
#   CIFS:  TYPE=cifs  OPTIONS=addr=192.168.1.10,username=playshelf,password=secret,vers=3.0,uid=82,gid=82,file_mode=0644,dir_mode=0755,ro  DEVICE=//192.168.1.10/playshelf/thumbnails
PLAYSHELF_THUMBNAILS_VOLUME_TYPE=none
PLAYSHELF_THUMBNAILS_VOLUME_OPTIONS=bind
PLAYSHELF_THUMBNAILS_VOLUME_DEVICE=/srv/playshelf/thumbnails

# ---------- Site ----------

# The site's name (page title, app bar, installed app). Read when the
# container starts: change it and restart, with no rebuild.
#SITE_NAME=PlayShelf

# The site's description (search results, link previews, installed app),
# one line of text. Also read when the container starts.
#SITE_DESCRIPTION=A hand-picked collection of YouTube videos, from any creator, grouped by game.

# ---------- Deployment ----------

# The name of the Compose project, container, network and Traefik router.
# Give each instance its own to run several (one per site) on one host.
#INSTANCE_NAME=playshelf

IMAGE_NAME=ghcr.io/kostelidisdev/playshelf
IMAGE_TAG=latest
#TZ=Europe/Athens

# ---------- Resources ----------

#PLAYSHELF_CPU_LIMIT=0.5
#PLAYSHELF_MEMORY_LIMIT=64M
#PLAYSHELF_MEMORY_RESERVATION=32M
#PLAYSHELF_PIDS_LIMIT=100

# ---------- Network ----------

# Must not overlap any other Docker network on the host, so give each
# instance its own.
#PLAYSHELF_NETWORK_SUBNET_V4=10.100.0.0/24
#PLAYSHELF_NETWORK_SUBNET_V6=fd00:100::/64
